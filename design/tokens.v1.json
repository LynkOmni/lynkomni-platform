 "known_limits": {
  "text-muted": "Disabled text and decorative hints only. It fails 4.5:1 in both themes by design; placeholders and helper text use text-secondary.",
  "border-strong": "Dividers and decorative rings only. Input boundaries use border-input (3:1 or better).",
  "brand-primary": "Fill colour. White text on it is 4.81:1 (AA). Violet used as TEXT uses brand-ink.",
  "accent-*": "Fill and large-graphics colours. Accent TEXT or icons use the matching -ink token."
 },
 "states": {
  "queued": {
   "label": "Queued",
   "icon": "clock",
   "tone": "neutral",
   "meaning": "Saved on this device, not sent yet."
  },
  "sent": {
   "label": "Sent",
   "icon": "arrow-up",
   "tone": "info",
   "meaning": "Left this device, awaiting the cloud. Relayed items stay here until the cloud accepts."
  },
  "accepted": {
   "label": "Accepted",
   "icon": "check",
   "tone": "info",
   "meaning": "The cloud stored it. A provider has not confirmed any money."
  },
  "confirmed": {
   "label": "Confirmed",
   "icon": "double-check",
   "tone": "success",
   "meaning": "The provider or issuer confirmed it."
  },
  "failed": {
   "label": "Failed",
   "icon": "cross",
   "tone": "danger",
   "meaning": "It did not go through. Nothing was charged unless a refund is shown."
  }
 },
 "modes": {
  "touch_target_px": 44,
  "min_text_scale_percent": 200,
  "lite": "System fonts only, no animation, no decorative images, smaller first load.",
  "sunlight": "Uses the high-contrast token set on demand, for bright outdoor screens."
 }
}
