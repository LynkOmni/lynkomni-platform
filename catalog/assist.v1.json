 "version": 1,
 "agreed": "2026-11-10",
 "rule": "MASTER UPDATE, master blueprint section 54: every action LynkAssist may take and every kind of answer it may give is in this register. An action outside it never runs. services/assist_register.py decides; tests/test_assist_register.py and the banks in tests/assist_bank/ prove it on every release.",
 "classes": {
  "A": {
   "level": "auto",
   "confirm": false,
   "fresh_check": false,
   "hand_over": false,
   "meaning": "solves alone: harmless and reversible"
  },
  "B": {
   "level": "draft",
   "confirm": true,
   "fresh_check": false,
   "hand_over": false,
   "meaning": "solves after Confirm"
  },
  "C": {
   "level": "draft",
   "confirm": true,
   "fresh_check": true,
   "hand_over": false,
   "meaning": "solves after a fresh identity check and Confirm"
  },
  "D": {
   "level": "inform",
   "confirm": false,
   "fresh_check": false,
   "hand_over": true,
   "meaning": "prepared for a human or licensed partner"
  }
 },
 "never_auto": [
  "credentials",
  "recovery",
  "tax_filing",
  "payroll",
  "finance_request",
  "exchange",
  "personal_data",
  "consent",
  "money_movement"
 ],
