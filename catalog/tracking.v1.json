{
 "version": 1,
 "description": "LynkOmni tracking (owner request 9 November 2026): one register of everything that moves through steps and that someone waits on, and one engine that follows it from the event log (services/tracking.py, ts/src/tracking.ts, shared vectors contract/vectors/tracking.v1.json). Each kind names its public id type (core/ids.py), the payload field that identifies the record, its steps in order with the events that reach them, who may see it and where. Screens, messages and automations read this file; no screen lists its own steps.",
 "states": [
  "queued",
  "sent",
  "accepted",
  "confirmed",
  "failed"
 ],
 "rules": [
  "A step is reached only by an event in the log (or, for services that keep their own state, by that service's state). Nothing is shown as done before the event that proves it: a delivery is delivered only on DeliveryDelivered, a payment confirmed only on the provider's callback.",
  "The chip beside a tracker uses only the five states: queued, sent, accepted, confirmed, failed. The step word says what happened.",
  "Screens show the steps reached so far, then the steps still expected; optional steps (a payment waiting for its provider, a repair waiting for parts) appear only once reached, and only one ending is shown: the one reached, or the one expected (a delivery when the order has one).",
  "Customers see a tracker with no account at its public address and see only customer steps: never an address, a phone number, a name other than the shop's, a rider's identity or coordinates.",
  "Live progress (delivery only) is a share between 0 and 1 and a time of arrival, worked out on LynkOmni's servers from positions the partner reports or the shop's own rider shares with consent during the trip. Positions are never stored in the event log, never shown to the customer, and are deleted when the trip ends.",
  "A tracker is late when its promised time has passed and it has not ended; the owner is told (automation tracking-late-watch) and the customer sees the new estimate, never a guess.",
  "Every step change a customer can see may send one message by the way they chose (automation order-updates: transactional, quiet hours, their language)."
 ],
 "kinds": [
  {
   "id": "delivery",
   "record": "DLV",
   "key": "delivery_id",
   "family": "lynkpos",
   "ui_section": 3,
   "live_progress": true,
   "parent": {
    "kind": "order",
    "event": "DeliveryRequested",
    "field": "order_id"
   },
   "eta": [
    {
     "event": "DeliveryAccepted",
     "field": "eta"
    }
   ],
   "viewers": {
    "merchant": "app.lynkomni.com/deliveries/{LODLV}",
    "customer": "shop.lynkomni.com/track/{LODLV}",
    "staff": "rider app"
   },
   "steps": [
    {
     "id": "requested",
     "state": "sent",
     "customer": true,
     "on": [
      {
       "event": "DeliveryRequested"
      }
     ]
    },
    {
     "id": "assigned",
     "state": "accepted",
     "customer": true,
     "on": [
      {
       "event": "DeliveryAccepted"
      }
     ]
    },
    {
     "id": "on_the_way",
     "state": "accepted",
     "customer": true,
     "on": [
      {
       "event": "DeliveryPickedUp"
      }
     ]
    },
    {
     "id": "delivered",
     "state": "confirmed",
     "customer": true,
     "terminal": true,
     "on": [
      {
       "event": "DeliveryDelivered"
      }
     ]
    },
    {
     "id": "failed",
     "state": "failed",
     "customer": true,
     "terminal": true,
     "on": [
      {
       "event": "DeliveryFailed"
      }
     ]
    }
   ]
  },
