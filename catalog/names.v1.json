 "similar_rule": "Names that sound alike or do neighbouring jobs are grouped here. Wherever one of them is explained (the note, search, LynkAssist, the product page), \"Which one do I need?\" shows the group side by side with each plain word and description. A new name that sounds like another joins a group in the same change.",
 "familiar_after": 10,
 "familiar_rule": "After a person has opened a service 10 times, the brackets after its name step back for them; the dotted underline and the note stay. They can keep the brackets in their names setting. Counted on the device only, never sent.",
 "welcome_rule": "The first time a person opens a service, one card shows its name with its plain word, what it does and its first three places to start (the first three items of its menu, from catalog/navigation.v1.json or the screen register). It closes with Got it and never returns on that device.",
 "plain_word_check": {
  "allowed_short": [
   "QR",
   "AI",
   "KI",
   "IA",
   "ID"
  ],
  "words_never": [
   "API",
   "SDK",
   "CRM",
   "ERP",
   "KPI",
   "SaaS",
   "POS",
   "GPS",
   "backend",
   "endpoint",
   "webhook",
   "database",
   "server",
   "dashboard"
  ],
  "rule": "A plain word is everyday words a person without technical knowledge understands: no short forms in capitals except the ones listed, no Lynk name, none of the listed technical words, in every language."
 },
 "asks": {
  "min_shown": 5,
  "rule": "How often each name's note, \"What is ...?\" answer or comparison is opened is counted on the device as name and place only, sent as totals, never with a person, device, account or time finer than a day, and shown to LynkOmni staff only as totals of 5 or more, to find names that still confuse people."
 },
 "outside": [
  {
   "place": "messages",
   "how": "Emails, texts, push notifications and the Messages page explain the first Lynk name in each message in brackets (ts/src/notify.ts, core/names.py explain_text).",
   "build_section": "4"
  },
  {
