{
 "version": 1,
 "agreed": "2026-11-10",
 "rule": "MASTER UPDATE, master blueprint section 59: one security register. Every protection is an entry: what it protects, the threat it answers, where it is enforced, the test that proves it, and the build section that builds it. A build section cannot be locked while one of its controls has no passing test. tests/test_security_register.py enforces this.",
 "principles": ["trust nothing by default", "layers", "least access", "safe by default", "assume a break-in will happen", "everything recorded", "proven, not claimed"],
 "assets": {
  "safety": "People's safety: positions, SOS, trusted contacts",
  "money": "Money paths: payments, payouts, card spending",
  "accounts": "Accounts and sign-in",
  "records": "Business records and the event log",
  "personal_data": "Personal data",
  "service": "The service staying up"
 },
 "open_updates": {
  "MASTER UPDATE": "Locked 10 November 2026. Its parts for Step 0 and sections 1, 2 and 3 are being built now, so planned controls in those sections are allowed while this update is open. It is removed from this list when section 3's parts are merged."
 },
 "threat_review": {
  "when": "Before each build section starts",
  "questions": ["What in this section is worth stealing or breaking?", "Who would try, and how?", "How do we stop it?", "How do we notice it?", "How do we recover?"],
  "result": "Each answer becomes a control in this register, with its test and build section"
 },
 "controls": [
  {"id": "event-log-chain", "asset": "records", "threat": "Someone quietly changes, removes or reorders stored events", "enforced_in": ["core/events.py"], "test": "tests/test_security_register.py::test_event_log_chain_detects_any_change", "build_section": 0, "status": "built"},
  {"id": "client-events-only", "asset": "records", "threat": "A device writes an event only the server may write", "enforced_in": ["services/suite.py"], "test": "tests/test_core.py::test_sync_idempotent_and_blocks_server_events", "build_section": 0, "status": "built"},
  {"id": "idempotent-events", "asset": "money", "threat": "A retried request counts a sale or a payment twice", "enforced_in": ["core/events.py"], "test": "tests/test_foundations.py::test_idempotent_random_and_unique", "build_section": 0, "status": "built"},
  {"id": "replay-gap-tamper", "asset": "records", "threat": "Old device batches are replayed, skipped or altered", "enforced_in": ["contract/tools/validate_contract.py"], "test": "tests/test_contract.py::test_replay_gap_and_tamper", "build_section": 0, "status": "built"},
  {"id": "sealed-mesh-batches", "asset": "records", "threat": "A LynkMesh relay reads or alters what it carries", "enforced_in": ["services/sealing.py"], "test": "tests/test_improvements.py::test_mesh_wrong_key_tamper_and_rate_limit", "build_section": 0, "status": "built"},
  {"id": "device-db-key", "asset": "records", "threat": "A device database is opened without its key", "enforced_in": ["core/devicedb.py"], "test": "tests/test_improvements.py::test_device_database_refuses_to_open_without_a_key", "build_section": 0, "status": "built"},
  {"id": "no-card-numbers", "asset": "money", "threat": "LynkOmni stores or shows a real card number", "enforced_in": ["services/vcard.py"], "test": "tests/test_vcard.py::test_card_numbers_are_never_stored_and_display_is_issuer_hosted", "build_section": 0, "status": "built"},
  {"id": "card-freeze-intent", "asset": "money", "threat": "A card is shown as frozen before the issuer confirms", "enforced_in": ["services/vcard.py"], "test": "tests/test_vcard.py::test_offline_freeze_is_only_an_intent", "build_section": 0, "status": "built"},
  {"id": "offline-risk-cap", "asset": "money", "threat": "Unconfirmed electronic payments pile up offline", "enforced_in": ["services/improvements.py"], "test": "tests/test_improvements.py::test_offline_risk_caps_non_cash_only_and_never_guarantees", "build_section": 0, "status": "built"},
  {"id": "merchant-logo-bytes", "asset": "personal_data", "threat": "A merchant logo carries script or markup", "enforced_in": ["services/merchant_logo.py"], "test": "tests/test_merchant_logo.py::test_refuses_svg_gif_html_and_script_hidden_in_an_image", "build_section": 0, "status": "built"},
  {"id": "secrets-scan", "asset": "accounts", "threat": "A private key or secret is committed to the code", "enforced_in": ["tools/security/scan_secrets.py", ".github/workflows/ci.yml"], "test": "tests/test_security_register.py::test_secret_scan_finds_planted_keys_and_the_repository_is_clean", "build_section": 0, "status": "built"},
  {"id": "sample-card-number", "asset": "money", "threat": "A sample card face shows a number that could work as a real card", "enforced_in": ["services/card_groups.py"], "test": "tests/test_card_groups.py::test_the_sample_number_can_never_be_a_real_card", "build_section": 0, "status": "built"},
  {"id": "passkeys-and-pin-lockout", "asset": "accounts", "threat": "Someone guesses a PIN or signs in without a passkey", "enforced_in": ["identity/platform.py", "identity/account.py"], "test": "tests/test_identity.py::test_pin_lockout_limited_sessions_and_offline_windows", "build_section": 2, "status": "built"},
  {"id": "step-up-and-recovery", "asset": "accounts", "threat": "A stolen session changes credentials or recovers an account", "enforced_in": ["identity/platform.py"], "test": "tests/test_identity.py::test_site_sessions_stepup_and_layered_recovery", "build_section": 2, "status": "built"},
  {"id": "payout-change-wait", "asset": "money", "threat": "A takeover redirects payouts at once", "enforced_in": ["identity/account.py"], "test": "tests/test_account.py::test_takeover_safeguards_payout_change_waits_and_exports_need_a_step_up", "build_section": 2, "status": "built"},
  {"id": "consent-records", "asset": "personal_data", "threat": "Data is shared without a named scope, purpose and end", "enforced_in": ["identity/account.py"], "test": "tests/test_account.py::test_consents_name_a_scope_a_purpose_and_an_end_and_the_automation_warns_and_ends_them", "build_section": 2, "status": "built"},
  {"id": "support-no-credentials", "asset": "accounts", "threat": "A support agent changes credentials or sees data without consent", "enforced_in": ["services/support.py"], "test": "tests/test_support.py::test_agents_cannot_change_credentials_and_support_needs_consent", "build_section": 6, "status": "built"},
  {"id": "business-settings-stepup", "asset": "money", "threat": "A sensitive business setting is changed by one person at once", "enforced_in": ["services/platform.py"], "test": "tests/test_improvements.py::test_business_settings_need_stepup_wait_and_second_owner", "build_section": 3, "status": "built"},
  {"id": "revoked-staff-flagged", "asset": "records", "threat": "A removed staff member's device keeps writing", "enforced_in": ["contract/tools/validate_contract.py"], "test": "tests/test_contract.py::test_revoked_staff_events_are_flagged_for_the_owner", "build_section": 3, "status": "built"},
  {"id": "offline-permission-limits", "asset": "accounts", "threat": "One stolen device approves many others or stays trusted for ever", "enforced_in": ["identity/offline.py"], "test": "tests/test_offline_identity.py::test_attack_bank", "build_section": 0, "status": "built"},
  {"id": "wrong-pin-hard-lock", "asset": "records", "threat": "A thief guesses the PIN, or wipes unsent sales by guessing badly", "enforced_in": ["identity/offline.py"], "test": "tests/test_offline_identity.py::test_wrong_pins_lock_hard_and_never_destroy", "build_section": 0, "status": "built"},
  {"id": "message-register-only", "asset": "personal_data", "threat": "A message is sent with no lawful basis, at night, twice, or carrying a secret", "enforced_in": ["services/messages.py"], "test": "tests/test_messages.py::test_nothing_outside_the_register_is_sent", "build_section": 0, "status": "built"},
  {"id": "assist-register-only", "asset": "accounts", "threat": "LynkAssist is talked into an action outside its register, class, role or limits", "enforced_in": ["services/assist_register.py"], "test": "tests/test_assist_register.py::test_an_action_outside_the_register_role_or_limits_never_runs", "build_section": 0, "status": "built"},
  {"id": "safe-page-settings", "asset": "accounts", "threat": "A page is framed, scripted from elsewhere or leaks data to other sites", "enforced_in": ["web/build.mjs"], "test": "tests/test_emulators.py", "build_section": 1, "status": "planned", "update": "MASTER UPDATE"},
  {"id": "device-tied-sessions", "asset": "accounts", "threat": "A copied session is used on another device", "enforced_in": ["identity/platform.py"], "test": "tests/test_identity.py", "build_section": 1, "status": "planned", "update": "MASTER UPDATE"},
  {"id": "security-center-full", "asset": "accounts", "threat": "A person cannot see or stop what is happening to their account", "enforced_in": ["identity/account.py"], "test": "tests/test_account.py", "build_section": 2, "status": "planned", "update": "MASTER UPDATE"},
  {"id": "staff-pin-and-integrity", "asset": "records", "threat": "A shared device hides who did what, or an altered app runs", "enforced_in": ["identity/platform.py"], "test": "tests/test_identity.py", "build_section": 3, "status": "planned", "update": "MASTER UPDATE"},
  {"id": "fraud-signals", "asset": "money", "threat": "Unusual sales, refunds or payouts go unnoticed", "enforced_in": [], "test": "", "build_section": 7, "status": "planned"},
  {"id": "position-store", "asset": "safety", "threat": "Positions are kept too long or seen by the wrong person", "enforced_in": [], "test": "", "build_section": "7B", "status": "planned"},
  {"id": "api-keys-and-webhooks", "asset": "accounts", "threat": "A leaked key or forged webhook acts for a merchant", "enforced_in": [], "test": "", "build_section": 11, "status": "planned"},
  {"id": "staff-access-and-watching", "asset": "personal_data", "threat": "Staff reach data without a task, or an attack goes unseen", "enforced_in": [], "test": "", "build_section": 12, "status": "planned"},
  {"id": "independent-attack-testing", "asset": "service", "threat": "A weakness only an outside attacker would find", "enforced_in": [], "test": "", "build_section": 14, "status": "planned"}
 ]
}
