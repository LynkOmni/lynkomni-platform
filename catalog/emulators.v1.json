{
 "version": 1,
 "agreed": "2026-11-18 (owner, EMULATOR UPDATE; master blueprint section 70)",
 "rule": "Every emulator of LynkOmni is listed here: its service, the device names it runs on, where it is built, whether it is a staff emulator counted by the plan or a free customer-facing screen, whether it needs a user, and the four checks (touch, buttons only, online and offline, internal and external). A service with a dedicated screen fails the tests until its emulators are here. The rules live in core/emulators.py with the TypeScript port ts/src/emulators.ts and shared vectors (python3 tools/emulators_vectors.py).",
 "touch_exceptions": {
  "board": "A display board has no touch by nature; it is used by remote control or its own buttons.",
  "counter_screen": "A small counter screen has no touch by nature; it follows the counter it is above."
 },
 "offline_kinds": {
  "works": "Works fully offline; records are sealed and sent when the device is back online.",
  "partner_parts_online_only": "Works offline for everything the service does alone; parts that need a licensed partner are never offered offline."
 },
 "user_kinds": {
  "needed": "A staff member signs in with their staff PIN.",
  "optional": "Works without a user; a staff member may sign in.",
  "none": "A customer-facing screen with no user."
 },
 "not_on_the_panel": {
  "button-phone": "Basic phones reach LynkOmni by USSD, text and voice with the staff PIN; the panel only shows that the channel is on.",
  "vcard-card": "A person's own LynkVCard lives in their own account.",
  "account-site": "A person's own LynkOmni account in their own browser.",
  "browser-frame": "The website and Business app in an ordinary browser.",
  "owner-web": "The Business app in the owner's own browser.",
  "mesh-relay": "LynkMesh is part of every device; it relays sealed data and is not assigned.",
  "track-page": "A page a customer opens on their own phone.",
  "queue-page": "A page a customer opens on their own phone.",
  "survey-page": "A page a person opens on their own phone."
 },
