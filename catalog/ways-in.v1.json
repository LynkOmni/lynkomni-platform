      "passkey",
      "security_key",
      "other_device",
      "qr_code",
      "authenticator",
      "backup_code",
      "recovery_code",
      "recovery_contacts",
      "email_code"
    ],
    "text_only_when": {
      "confirm_number": "Proving a phone number when it is added or changed (sign-up, a contact change): only a code sent to that number proves it.",
      "recovery_email_and_phone": "The Can't sign in? way that needs codes to both the email and the phone, for someone who has lost every free way."
    },
    "basic_phones": "Basic phones use USSD menus with the account PIN; the network session itself shows the number, so no text code is needed.",
    "alerts": "LynkOmni's own alerts never go by text: they repeat free until read, and the change they are about is held when nobody was reached (catalog/messages.v1.json own_messages)."
  }
