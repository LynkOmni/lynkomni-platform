{
 "$id": "lynkomni/command-policy-register.v4",
 "description": "Command register version 4 (NEW UPDATE 1, 2026-11-10): version 2's commands unchanged plus the commands that issue the device events of LynkTrace, LynkGPS and LynkSentry (all class A: they work offline and the cloud never refuses them).",
 "class_defaults": {
  "A": {
   "retry": "none",
   "note": "Local transaction. Sync of the resulting event follows the sync protocol, not command retry."
  },
  "B": {
   "retry": {
    "backoff_base_seconds": 5,
    "backoff_max_seconds": 900,
    "jitter": true,
    "max_age_days": 30,
    "on_expiry": "escalate_to_owner"
   }
  },
  "C": {
   "retry": {
    "timeout_seconds": 30,
    "max_attempts": 3,
    "backoff_base_seconds": 2,
    "jitter": true,
    "on_exhausted": "show_failed_with_reason"
   }
  }
 },
 "session_policy": {
  "offline_session_max_days_default": 14,
  "on_expiry": "selling_pauses_data_stays_safe_syncs_after_reauth"
 },
 "commands": [
  {
   "name": "RecordSale",
   "class": "A",
   "v1": true,
   "emits": [
    "SaleRecorded",
    "ReceiptIssued"
   ],
   "permission": "sale.record",
   "channels": [
    "mobile"
   ],
   "offline": {
    "allowed": true
   },
   "cloud_may_reject": false,
   "cloud_outcomes": [
    "accepted",
    "accepted_flagged",
    "quarantined_identity_or_integrity_only"
   ],
   "local_rejections": [
    "empty_cart",
    "invalid_amount",
    "product_not_found_local",
    "discount_over_limit",
    "permission_denied",
    "session_expired",
    "device_locked"
   ],
   "ui_states": [
    "recorded",
    "pending_sync",
    "accepted"
   ]
  },
  {
   "name": "VoidSale",
   "class": "A",
   "v1": true,
