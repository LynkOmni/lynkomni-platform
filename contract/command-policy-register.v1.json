{
  "$id": "lynkomni/command-policy-register.v1",
  "description": "One row per command a module may submit to LynkDVBox. A command not listed here is rejected locally. Class A = local fact (executes offline, never rejected by LynkCCBox, only accepted, flagged or quarantined for identity/integrity failure). Class B = deferred (recorded locally, cloud may reject later, UI shows Pending). Class C = live cloud (needs current cloud state or a provider; offline it is refused with a clear reason or stays Pending where safe; never faked).",
  "class_defaults": {
    "A": { "retry": "none", "note": "Local transaction. Sync of the resulting event follows the sync protocol, not command retry." },
    "B": { "retry": { "backoff_base_seconds": 5, "backoff_max_seconds": 900, "jitter": true, "max_age_days": 30, "on_expiry": "escalate_to_owner" } },
    "C": { "retry": { "timeout_seconds": 30, "max_attempts": 3, "backoff_base_seconds": 2, "jitter": true, "on_exhausted": "show_failed_with_reason" } }
  },
  "session_policy": { "offline_session_max_days_default": 14, "on_expiry": "selling_pauses_data_stays_safe_syncs_after_reauth" },
  "commands": [
    {
      "name": "RecordSale", "class": "A", "v1": true,
      "emits": ["SaleRecorded", "ReceiptIssued"],
      "permission": "sale.record", "channels": ["mobile"],
      "offline": { "allowed": true },
      "cloud_may_reject": false,
      "cloud_outcomes": ["accepted", "accepted_flagged", "quarantined_identity_or_integrity_only"],
      "local_rejections": ["empty_cart", "invalid_amount", "product_not_found_local", "discount_over_limit", "permission_denied", "session_expired", "device_locked"],
      "ui_states": ["recorded", "pending_sync", "accepted"]
    },
    {
      "name": "VoidSale", "class": "A", "v1": true,
      "emits": ["SaleVoided"],
      "permission": "sale.void", "channels": ["mobile"],
      "offline": { "allowed": true },
      "cloud_may_reject": false,
      "cloud_outcomes": ["accepted", "accepted_flagged", "quarantined_redundant_void_return"],
      "local_rejections": ["sale_not_found_local", "already_voided", "already_returned", "permission_denied", "session_expired", "device_locked"],
      "ui_states": ["voided"]
    },
    {
      "name": "RecordReturn", "class": "A", "v1": true,
      "emits": ["ReturnRecorded"],
      "permission": "sale.return", "channels": ["mobile"],
      "offline": { "allowed": true },
      "cloud_may_reject": false,
      "cloud_outcomes": ["accepted", "accepted_flagged", "quarantined_redundant_void_return"],
      "local_rejections": ["sale_not_found_local", "already_voided", "quantity_exceeds_sold", "permission_denied", "session_expired", "device_locked"],
      "ui_states": ["returned"]
    },
    {
      "name": "RecordPayment", "class": "A", "v1": true,
      "emits": ["PaymentRecorded"],
      "permission": "payment.record", "channels": ["mobile"],
      "offline": { "allowed": true, "note": "Records the payment fact. Non-cash payments are stored as pending_confirmation and are never shown as settled until confirmed." },
      "cloud_may_reject": false,
      "cloud_outcomes": ["accepted", "accepted_flagged"],
      "local_rejections": ["sale_not_found_local", "invalid_amount", "method_status_mismatch", "permission_denied", "session_expired", "device_locked"],
      "ui_states": ["cash_received", "pending_confirmation", "credit_open"]
    },
    {
      "name": "ConfirmPaymentManually", "class": "A", "v1": true,
      "emits": ["PaymentStatusChanged"],
      "permission": "payment.confirm_manual", "channels": ["mobile"],
      "offline": { "allowed": true, "note": "Always labeled 'Confirmed manually' and flagged for owner review." },
      "cloud_may_reject": false,
      "cloud_outcomes": ["accepted_flagged"],
      "local_rejections": ["payment_not_found_local", "payment_not_pending", "permission_denied", "session_expired", "device_locked"],
      "ui_states": ["manually_confirmed", "credit_settled"]
    },
    {
      "name": "CreateProduct", "class": "A", "v1": true,
      "emits": ["ProductCreated"],
      "permission": "product.create", "channels": ["mobile"],
      "offline": { "allowed": true },
      "cloud_may_reject": false,
      "cloud_outcomes": ["accepted", "accepted_flagged"],
      "local_rejections": ["duplicate_barcode_local", "invalid_price", "permission_denied", "session_expired", "device_locked"],
      "ui_states": ["recorded", "pending_sync", "accepted"]
    },
    {
      "name": "UpdateProduct", "class": "A", "v1": true,
      "emits": ["ProductUpdated"],
      "permission": "product.update",
      "extra_permissions": [{ "when": "changes.price", "permission": "product.price_change" }],
      "channels": ["mobile"],
      "offline": { "allowed": true },
      "cloud_may_reject": false,
      "cloud_outcomes": ["accepted", "accepted_with_conflict_notice"],
      "local_rejections": ["product_not_found_local", "no_changes", "invalid_price", "permission_denied", "session_expired", "device_locked"],
      "ui_states": ["recorded", "pending_sync", "accepted"]
    },
    {
      "name": "ArchiveProduct", "class": "A", "v1": true,
      "emits": ["ProductArchived"],
      "permission": "product.archive", "channels": ["mobile"],
      "offline": { "allowed": true },
      "cloud_may_reject": false,
      "cloud_outcomes": ["accepted", "accepted_with_conflict_notice"],
      "local_rejections": ["product_not_found_local", "already_archived", "permission_denied", "session_expired", "device_locked"],
      "ui_states": ["recorded", "pending_sync", "accepted"]
    },
    {
      "name": "ReceiveStock", "class": "A", "v1": true,
      "emits": ["StockReceived"],
      "permission": "stock.receive", "channels": ["mobile"],
      "offline": { "allowed": true },
      "cloud_may_reject": false,
      "cloud_outcomes": ["accepted", "accepted_flagged"],
      "local_rejections": ["product_not_found_local", "invalid_quantity", "permission_denied", "session_expired", "device_locked"],
      "ui_states": ["recorded", "pending_sync", "accepted"]
    },
    {
      "name": "AdjustStock", "class": "A", "v1": true,
      "emits": ["StockAdjusted"],
      "permission": "stock.adjust", "channels": ["mobile"],
      "offline": { "allowed": true },
      "cloud_may_reject": false,
      "cloud_outcomes": ["accepted", "accepted_flagged"],
      "local_rejections": ["product_not_found_local", "zero_delta", "reason_required", "permission_denied", "session_expired", "device_locked"],
      "ui_states": ["recorded", "pending_sync", "accepted"]
    },
    {
      "name": "CountStock", "class": "A", "v1": true,
      "emits": ["StockCounted"],
      "permission": "stock.count", "channels": ["mobile"],
      "offline": { "allowed": true },
      "cloud_may_reject": false,
      "cloud_outcomes": ["accepted", "accepted_flagged"],
      "local_rejections": ["product_not_found_local", "invalid_quantity", "permission_denied", "session_expired", "device_locked"],
      "ui_states": ["recorded", "pending_sync", "accepted"]
    },
    {
      "name": "ReprintReceipt", "class": "A", "v1": true,
      "emits": ["ReceiptIssued"],
      "permission": "receipt.reprint", "channels": ["mobile"],
      "offline": { "allowed": true },
      "cloud_may_reject": false,
      "cloud_outcomes": ["accepted"],
      "local_rejections": ["sale_not_found_local", "printer_unavailable", "permission_denied", "session_expired", "device_locked"],
      "ui_states": ["provisional"]
    },
    {
      "name": "ChangeLocalSettings", "class": "A", "v1": true,
      "emits": [],
      "permission": null, "local_only": true, "channels": ["mobile"],
      "offline": { "allowed": true, "note": "Language, printer choice and similar device-only preferences. Never synced." },
      "cloud_may_reject": false,
      "cloud_outcomes": [],
      "local_rejections": ["invalid_value", "device_locked"],
      "ui_states": []
    },
    {
      "name": "SubmitDiagnostics", "class": "B", "v1": true,
      "emits": [],
      "permission": "sync.view", "channels": ["mobile"],
      "offline": { "allowed": true, "note": "Queued until online. Bundle contains no customer data." },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted", "rejected_rate_limited", "rejected_too_large"],
      "local_rejections": ["bundle_too_large", "device_locked"],
      "ui_states": ["pending_sync", "accepted"]
    },
    {
      "name": "RequestTaxSubmission", "class": "B", "v1": false, "deferred_until": "RRA written outcome (spec section 9)",
      "emits": [],
      "permission": "report.view", "channels": ["mobile"],
      "offline": { "allowed": true },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted", "rejected_invalid_invoice", "pending_authority"],
      "local_rejections": ["sale_not_found_local", "device_locked"],
      "ui_states": ["pending_sync", "submitted"]
    },
    {
      "name": "SignIn", "class": "C", "v1": true,
      "emits": [],
      "permission": null, "pre_auth": true, "channels": ["mobile", "web"],
      "offline": { "allowed": false, "behavior": "refuse_with_reason", "note": "Daily unlock uses the local PIN, which is not SignIn." },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted", "rejected_bad_code", "rejected_locked_out", "rejected_rate_limited"],
      "local_rejections": ["malformed_phone", "offline_not_possible"],
      "ui_states": ["pending", "signed_in", "failed"]
    },
    {
      "name": "RefreshSession", "class": "C", "v1": true,
      "emits": [],
      "permission": null, "any_authenticated": true, "channels": ["mobile", "web"],
      "offline": { "allowed": false, "behavior": "refuse_with_reason", "note": "Must succeed within offline_session_max_days or selling pauses." },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted", "rejected_revoked", "rejected_expired"],
      "local_rejections": ["offline_not_possible"],
      "ui_states": ["pending", "refreshed", "failed"]
    },
    {
      "name": "EnrollDevice", "class": "C", "v1": true,
      "emits": ["DeviceEnrolled"],
      "permission": "device.enroll", "channels": ["mobile"],
      "offline": { "allowed": false, "behavior": "refuse_with_reason" },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted", "rejected_not_approved", "rejected_attestation_failed", "rejected_rate_limited"],
      "local_rejections": ["offline_not_possible", "keystore_unavailable"],
      "ui_states": ["pending", "enrolled", "failed"]
    },
    {
      "name": "AddUser", "class": "C", "v1": true,
      "emits": ["UserAdded"],
      "permission": "user.add", "channels": ["mobile"],
      "offline": { "allowed": false, "behavior": "refuse_with_reason" },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted", "rejected_duplicate", "rejected_limit_reached"],
      "local_rejections": ["offline_not_possible", "permission_denied"],
      "ui_states": ["pending", "added", "failed"]
    },
    {
      "name": "ChangeUserRole", "class": "C", "v1": true,
      "emits": ["UserRoleChanged"],
      "permission": "user.change_role", "channels": ["mobile"],
      "offline": { "allowed": false, "behavior": "refuse_with_reason" },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted", "rejected_last_owner", "rejected_recovery_window"],
      "local_rejections": ["offline_not_possible", "permission_denied"],
      "ui_states": ["pending", "changed", "failed"]
    },
    {
      "name": "ResetStaffCredentials", "class": "C", "v1": true,
      "emits": [],
      "permission": "user.reset_credentials", "channels": ["mobile"],
      "offline": { "allowed": false, "behavior": "refuse_with_reason" },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted", "rejected_not_staff"],
      "local_rejections": ["offline_not_possible", "permission_denied"],
      "ui_states": ["pending", "done", "failed"]
    },
    {
      "name": "RevokeDevice", "class": "C", "v1": true,
      "emits": ["DeviceRevoked"],
      "permission": "device.revoke", "channels": ["mobile", "web"],
      "offline": { "allowed": false, "behavior": "refuse_with_reason", "note": "Revocation takes effect when the cloud enforces it; a disconnected target device learns of it on reconnect." },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted", "rejected_recovery_window", "rejected_unknown_device"],
      "local_rejections": ["offline_not_possible", "permission_denied"],
      "ui_states": ["pending", "revoked", "failed"]
    },
    {
      "name": "ChangeSharedSettings", "class": "C", "v1": true,
      "emits": ["ConfigChanged"],
      "permission": "settings.change", "channels": ["mobile"],
      "offline": { "allowed": false, "behavior": "refuse_with_reason" },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted", "rejected_invalid_value", "rejected_recovery_window"],
      "local_rejections": ["offline_not_possible", "permission_denied", "invalid_value"],
      "ui_states": ["pending", "applied", "failed"]
    },
    {
      "name": "FetchSnapshot", "class": "C", "v1": true,
      "emits": [],
      "permission": "sync.view", "channels": ["mobile"],
      "offline": { "allowed": false, "behavior": "refuse_with_reason" },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted", "rejected_revoked"],
      "local_rejections": ["offline_not_possible"],
      "ui_states": ["pending", "loaded", "failed"]
    },
    {
      "name": "InitiateRecovery", "class": "C", "v1": true,
      "emits": [],
      "permission": null, "pre_auth": true, "channels": ["mobile"],
      "offline": { "allowed": false, "behavior": "refuse_with_reason" },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted_waiting_period", "rejected_rate_limited", "rejected_unknown_account"],
      "local_rejections": ["offline_not_possible"],
      "ui_states": ["pending", "waiting_period", "failed"]
    },
    {
      "name": "ApproveRecovery", "class": "C", "v1": true,
      "emits": [],
      "permission": "recovery.approve", "channels": ["mobile"],
      "offline": { "allowed": false, "behavior": "refuse_with_reason" },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted", "rejected_expired", "rejected_cancelled"],
      "local_rejections": ["offline_not_possible", "permission_denied"],
      "ui_states": ["pending", "approved", "failed"]
    },
    {
      "name": "CancelRecovery", "class": "C", "v1": true,
      "emits": [],
      "permission": "recovery.cancel", "channels": ["mobile", "web"],
      "offline": { "allowed": false, "behavior": "refuse_with_reason" },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted", "rejected_not_found"],
      "local_rejections": ["offline_not_possible", "permission_denied"],
      "ui_states": ["pending", "cancelled", "failed"]
    },
    {
      "name": "RequestMobileMoneyPayment", "class": "C", "v1": false, "deferred_until": "payments module activation checklist (spec section 13)",
      "emits": [],
      "permission": "payment.record", "channels": ["mobile"],
      "offline": { "allowed": false, "behavior": "stay_pending_or_refuse", "note": "Never faked. Offline it can only be recorded as a pending_confirmation payment fact." },
      "cloud_may_reject": true,
      "cloud_outcomes": ["accepted_pending_provider", "rejected_provider_error"],
      "local_rejections": ["invalid_amount", "offline_not_possible"],
      "ui_states": ["pending_confirmation", "confirmed", "failed"]
    }
  ]
}
