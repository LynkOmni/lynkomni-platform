{
 "$id": "lynkomni/vcard.v1",
 "status": "extension registry, schema_version 1 of the vcard namespace. Merchant-core contract v1 is unchanged.",
 "names": {
  "full": "LynkOmni Virtual Card",
  "short": "LynkVCard",
  "url": "https://lynkomni.com/vcard",
  "risk_box": "LynkOmni Virtual Card Risk Box (LynkVCRBox)"
 },
 "rules": [
  "Raw PAN, CVV and expiry are never received, stored or logged by LynkOmni. Display is issuer-hosted and ephemeral.",
  "Every Request* command carries an idempotency_key; the cloud and the issuer both honor it, so a retry never debits twice.",
  "Only RequestFreeze may be queued offline, as an intent with a 24 hour life and a one-time nonce. A queued intent is never shown as a freeze; only VirtualCardFrozen is.",
  "Cards, transactions, disputes and physical companions have separate state machines.",
  "A card receipt is a payment record, never a fiscal invoice. The supplier's own fiscal receipt reference may be attached.",
  "3-D Secure approval is an in-app, device-bound approval with SMS OTP as fallback. Never through a chat thread.",
  "A country pack alone never enables cards. It needs a signed issuer agreement, legal sign-off and the activation checklist."
 ],
 "id_types": {
  "card": "VC",
  "physical_companion": "PC",
  "transaction": "TXN",
  "receipt": "RCP",
  "supplier_score": "SC",
  "dispute": "CASE"
 },
 "card_states": [
  "requested",
  "issued",
  "active",
  "frozen",
  "closed",
  "expired"
 ],
 "card_transitions": {
  "requested": [
   "issued"
  ],
  "issued": [
   "active",
   "closed"
  ],
  "active": [
   "frozen",
   "closed",
   "expired"
  ],
  "frozen": [
   "active",
   "closed"
  ],
  "closed": [],
  "expired": [
   "active"
  ]
 },
 "transaction_states": [
  "authorized",
  "settled",
  "reversed",
  "disputed"
 ],
 "dispute_states": [
  "opened",
  "evidence",
  "resolved"
 ],
 "physical_states": [
  "ordered",
  "shipped",
  "activated",
  "replaced"
 ],
 "permissions": {
  "vcard.view": {
   "roles": [
    "cashier",
    "manager",
    "owner"
   ],
   "note": "view last four digits, status, limits and receipts. Cashiers see only the team card assigned to them"
  },
  "vcard.create": {
   "roles": [
    "manager",
    "owner"
   ],
   "note": "create cards within the plan limits. Pro: a manager's request waits for an owner approval above the manager limit"
  },
  "vcard.fund": {
   "roles": [
    "manager",
    "owner"
   ],
   "note": "fund a card from a pack payment method"
  },
  "vcard.freeze": {
   "roles": [
    "cashier",
    "manager",
    "owner"
   ],
   "note": "freeze: a cashier may freeze only their own team card"
  },
  "vcard.unfreeze": {
   "roles": [
    "manager",
    "owner"
   ],
   "note": "unfreeze, only when no open risk case"
  },
  "vcard.close": {
   "roles": [
    "owner"
   ],
   "note": "close a card"
  },
  "vcard.limits": {
   "roles": [
    "owner"
   ],
   "note": "change caps and locks"
  },
  "vcard.team": {
   "roles": [
    "manager",
    "owner"
   ],
   "note": "team, supplier, time and shift cards"
  },
  "vcard.dispute": {
   "roles": [
    "manager",
    "owner"
   ],
   "note": "open and evidence a dispute"
  },
  "vcard.physical": {
   "roles": [
    "owner"
   ],
   "note": "order, activate and replace a physical companion"
  },
  "vcard.approve": {
   "roles": [
    "manager",
    "owner"
   ],
   "note": "approve a pending card request, in the app and never in chat"
  },
  "vcard.display": {
   "roles": [
    "owner"
   ],
   "note": "open the issuer-hosted card display, needs step-up"
  },
  "vcard.wallet": {
   "roles": [
    "manager",
    "owner"
   ],
   "note": "add the card to Apple Pay or Google Pay where the issuer supports it"
  }
 },
 "commands": [
  {
   "name": "RequestVirtualCard",
   "class": "C",
   "permission": "vcard.create",
   "idempotent": true,
   "offline": "refused_offline",
   "fields": [
    "idempotency_key",
    "type",
    "lock",
    "amount_base",
    "expiry_utc",
    "auto_renew",
    "rotation_policy",
    "funding_source_id"
   ]
  },
  {
   "name": "RequestFunding",
   "class": "C",
   "permission": "vcard.fund",
   "idempotent": true,
   "offline": "refused_offline",
   "fields": [
    "idempotency_key",
    "card",
    "funding_source_id",
    "amount_base"
   ]
  },
  {
   "name": "RequestFreeze",
   "class": "C",
   "permission": "vcard.freeze",
   "idempotent": true,
   "offline": "queued_intent_ttl_24h",
   "fields": [
    "idempotency_key",
    "card",
    "reason",
    "nonce"
   ]
  },
  {
   "name": "RequestUnfreeze",
   "class": "C",
