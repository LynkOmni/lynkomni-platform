   "idempotent": true,
   "offline": "refused_offline",
   "fields": [
    "idempotency_key",
    "card",
    "per_txn_cap",
    "period_cap",
    "category_locks"
   ]
  },
  {
   "name": "RequestRotateCard",
   "class": "C",
   "permission": "vcard.limits",
   "idempotent": true,
   "offline": "refused_offline",
   "fields": [
