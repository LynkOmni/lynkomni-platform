    "idempotency_key",
    "card"
   ]
  },
  {
   "name": "RequestClose",
   "class": "C",
   "permission": "vcard.close",
   "idempotent": true,
   "offline": "refused_offline",
   "fields": [
    "idempotency_key",
    "card"
   ]
  },
  {
   "name": "RequestChangeLimits",
   "class": "C",
