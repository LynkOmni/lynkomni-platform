{
  "$id": "lynkomni/permissions.v1",
  "description": "Who may do what. LynkDVBox enforces this locally from the last cached role; LynkCCBox re-verifies on every sync and rejects or flags anything the role did not allow at the time. Roles are strictly nested: cashier is a subset of manager, manager is a subset of owner.",
  "roles": ["cashier", "manager", "owner"],
  "web_access_v1_roles": ["owner"],
  "recovery_window_hours": 24,
  "permissions": [
    { "id": "sale.record", "roles": ["cashier", "manager", "owner"], "channels": ["mobile"], "note": "Record a sale offline or online." },
    { "id": "sale.discount.apply", "roles": ["cashier", "manager", "owner"], "channels": ["mobile"], "note": "Cashier limited by discount_limit_percent_cashier in config." },
    { "id": "sale.discount.unlimited", "roles": ["manager", "owner"], "channels": ["mobile"] },
    { "id": "sale.void", "roles": ["manager", "owner"], "channels": ["mobile"] },
    { "id": "sale.return", "roles": ["manager", "owner"], "channels": ["mobile"] },
    { "id": "sale.view_own", "roles": ["cashier", "manager", "owner"], "channels": ["mobile"] },
    { "id": "sale.view_all", "roles": ["manager", "owner"], "channels": ["mobile", "web"] },
    { "id": "payment.record", "roles": ["cashier", "manager", "owner"], "channels": ["mobile"] },
    { "id": "payment.confirm_manual", "roles": ["manager", "owner"], "channels": ["mobile"], "note": "Always labeled manually confirmed; flagged for owner review." },
    { "id": "product.view", "roles": ["cashier", "manager", "owner"], "channels": ["mobile"] },
    { "id": "product.create", "roles": ["manager", "owner"], "channels": ["mobile"] },
    { "id": "product.update", "roles": ["manager", "owner"], "channels": ["mobile"] },
    { "id": "product.price_change", "roles": ["manager", "owner"], "channels": ["mobile"], "note": "Separate permission so price changes are auditable." },
    { "id": "product.archive", "roles": ["manager", "owner"], "channels": ["mobile"] },
    { "id": "stock.view", "roles": ["cashier", "manager", "owner"], "channels": ["mobile"] },
    { "id": "stock.receive", "roles": ["manager", "owner"], "channels": ["mobile"] },
    { "id": "stock.adjust", "roles": ["manager", "owner"], "channels": ["mobile"] },
    { "id": "stock.count", "roles": ["manager", "owner"], "channels": ["mobile"] },
    { "id": "receipt.reprint", "roles": ["cashier", "manager", "owner"], "channels": ["mobile"], "note": "Reprints are marked COPY." },
    { "id": "report.view", "roles": ["manager", "owner"], "channels": ["mobile", "web"] },
    { "id": "sync.view", "roles": ["cashier", "manager", "owner"], "channels": ["mobile", "web"] },
    { "id": "quarantine.view", "roles": ["manager", "owner"], "channels": ["mobile", "web"] },
    { "id": "user.add", "roles": ["owner"], "channels": ["mobile"] },
    { "id": "user.change_role", "roles": ["owner"], "channels": ["mobile"], "blocked_in_recovery_window": true },
    { "id": "user.reset_credentials", "roles": ["owner"], "channels": ["mobile"], "note": "Staff cannot self-recover; the owner resets them." },
    { "id": "device.view", "roles": ["owner"], "channels": ["mobile", "web"] },
    { "id": "device.enroll", "roles": ["owner"], "channels": ["mobile"], "note": "Staff devices enroll only with owner approval." },
    { "id": "device.revoke", "roles": ["owner"], "channels": ["mobile", "web"], "blocked_in_recovery_window": true },
    { "id": "settings.change", "roles": ["owner"], "channels": ["mobile"], "blocked_in_recovery_window": true },
    { "id": "audit.view", "roles": ["owner"], "channels": ["web"] },
    { "id": "data.export", "roles": ["owner"], "channels": ["web"], "blocked_in_recovery_window": true },
    { "id": "recovery.approve", "roles": ["owner"], "channels": ["mobile"], "note": "Approve a recovery from another enrolled owner device (path 1)." },
    { "id": "recovery.cancel", "roles": ["owner"], "channels": ["mobile", "web"], "note": "Cancel a pending recovery from any owner session. The backup contact can also cancel through the alert link." },
    { "id": "branch.manage", "roles": ["owner"], "channels": ["mobile"], "deferred": true, "note": "Schema carries branch_id now; screens come later." },
    { "id": "payout.change", "roles": ["owner"], "channels": ["mobile"], "deferred": true, "blocked_in_recovery_window": true }
  ]
}
